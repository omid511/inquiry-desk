# Demo fallback must be explicitly enabled. Demo owner login: demo
DEMO_MODE=true
# Required when DEMO_MODE=false. The publishable key is safe for browser-facing
# Supabase Auth clients; the service-role key remains server-only for identity
# provisioning and must never be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Set to use an OpenAI-compatible JSON extraction provider; otherwise mock extraction runs locally.
EXTRACTION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Demo-only owner access code override. Persisted mode uses Supabase Auth.
OWNER_ACCESS_TOKEN=
# The workspace provisioned for newly authenticated users. Existing memberships
# and roles remain authoritative; new users are provisioned as viewers.
DEFAULT_WORKSPACE_ID=demo-workspace
DEFAULT_WORKSPACE_ROLE=viewer
PUBLIC_WORKSPACE_ID=demo-workspace
RETENTION_DAYS=365
# Optional signed integration boundaries.
INBOUND_WEBHOOK_SECRET=
INBOUND_WEBHOOK_WORKSPACE_ID=demo-workspace
OUTBOUND_EMAIL_PROVIDER=mock
OUTBOUND_EMAIL_WEBHOOK_URL=
OUTBOUND_EMAIL_WEBHOOK_SECRET=
